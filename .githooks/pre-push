#!/usr/bin/env bash
# Ensure package.json, Cargo.toml, tauri.conf.json, and index.html agree before push.
set -Eeuo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node is required to run version-check" >&2
  exit 1
fi

node scripts/release.mjs check
