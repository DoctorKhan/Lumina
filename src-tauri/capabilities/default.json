{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default app permissions",
  "windows": [
    "main",
    "doc-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "process:default"
  ]
}
